# /etc/systemd/system/iampresident-realtime.service
# WebSocket relay. INTERNAL_KEY comes from an env file the deploy pipeline writes,
# so it always matches conf.php's 'internal-key'.
#   sudo systemctl enable --now iampresident-realtime
[Unit]
Description=I Am President — realtime WS relay
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/iampresident/realtime
# Written by CI (deploy/realtime.env): PORT, HOST, INTERNAL_KEY. '-' = optional.
EnvironmentFile=-/var/www/iampresident/deploy/realtime.env
ExecStart=/usr/bin/node /var/www/iampresident/realtime/server.js
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
