# /etc/systemd/system/iampresident-tick.service
# The game heartbeat: advances every active match on its tick interval.
#   sudo systemctl enable --now iampresident-tick
[Unit]
Description=I Am President — tick worker
After=network.target mysql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/iampresident
ExecStart=/usr/bin/php /var/www/iampresident/worker/tick.php --quiet
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
